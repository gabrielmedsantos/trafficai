PORT=3001
NODE_ENV=development

# ─── Database — SQLite Local (Development) ────────────────────────────────────
# SQLite para desenvolvimento local — Zero dependências externas
# Para usar PostgreSQL em produção: DATABASE_URL=postgresql://user:pass@host:5432/db
DATABASE_URL=sqlite:./livestream.db

# ─── Redis (in-memory — sem servidor necessário) ─────────────────────────────
REDIS_URL=memory

# ─── Auth ────────────────────────────────────────────────────────────────────
JWT_SECRET=lsc_super_secret_jwt_2026_change_me
JWT_EXPIRES_IN=7d

# ─── RTMP / HLS ──────────────────────────────────────────────────────────────
RTMP_PORT=1935
RTMP_HTTP_PORT=8000
HLS_ROOT=./hls
FFMPEG_PATH=C:\Users\Medeiros\AppData\Local\Microsoft\WinGet\Packages\Gyan.FFmpeg_Microsoft.Winget.Source_8wekyb3d8bbwe\ffmpeg-8.1-full_build\bin\ffmpeg.exe

# ─── Frontend ────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000

# ─── LiveKit ─────────────────────────────────────────────────────────────────
# Toggle de conta: primary (padrão) | backup
# Trocar para 'backup' + pm2 restart livecontrol-backend quando o plano da
# conta primária expirar. O frontend detecta via GET /livekit/config.
LIVEKIT_PROVIDER=primary

# PRIMARY — Live Control (conta atual)
LIVEKIT_URL=wss://live-control-vv1fezvo.livekit.cloud
LIVEKIT_API_KEY=APIwd8jAxufBzkD
LIVEKIT_API_SECRET=oM5gmdieAQTt1nrRptlCgdV7SubfvrgP5pHdMhFcfpTB

# BACKUP — conta reserva (outra org LiveKit Cloud). Não use sem swap do PROVIDER.
LIVEKIT_URL_BACKUP=wss://v3-5pzt25jn.livekit.cloud
LIVEKIT_API_KEY_BACKUP=API75GfYEVXdXgt
LIVEKIT_API_SECRET_BACKUP=asQWDZey7lFxzOjNIrM83zaFgd9PyfwsvcIkU4v3Ff1B
